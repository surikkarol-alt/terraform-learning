# Terraform working directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plan files
*.tfplan
tfplan

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files - may contain sensitive data
*.tfvars
*.tfvars.json

# Local state copies / backups
state-*.json
*state-copy*.json
*.backup

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# SSH private keys
*.pem
*.key
id_rsa
id_ed25519

# Editor / OS temporary files
.vscode/
.idea/
*.swp
*~
.DS_Store
